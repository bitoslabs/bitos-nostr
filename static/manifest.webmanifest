{
	"name": "BitOS",
	"short_name": "BitOS",
	"description": "A local-first Nostr social client for feed, chat, and relays.",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"background_color": "#f4f7fb",
	"theme_color": "#f4f7fb",
	"share_target": {
		"action": "/studio/create",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url",
			"files": [{ "name": "files", "accept": ["image/*", "video/*"] }]
		}
	},
	"icons": [
		{
			"src": "/icons/icon-192-192.png",
			"sizes": "192x192",
			"type": "image/png"
		},
		{
			"src": "/icons/icon-512-512.png",
			"sizes": "512x512",
			"type": "image/png"
		}
	]
}
